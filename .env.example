# All optional; the values shown are the defaults. Docker Compose reads .env; for `npm start` export them in your shell
# (or run `node --env-file=.env dist/server.js`).
PORT=8080
# The boards to crawl
# SOURCES_FILE=data/sources.json
# How often each source is re-crawled, and how many are crawled at once
REFRESH_MINUTES=60
CRAWL_CONCURRENCY=4
# A source that has not succeeded for this long loses its jobs
STALE_HOURS=72
# Jobs older than this many days (by posted date, or first-seen when there is none) are deleted
JOB_MAX_AGE_DAYS=30
# Keep a copy of the jobs on disk so a restart does not start empty (off by default)
# SNAPSHOT_FILE=data/jobs.ndjson.gz
# Per-job detail cache: a fetched job detail is reused for this long
DETAIL_TTL_HOURS=168
# Max job pages fetched per crawl by the HTML/JSON-LD connectors and by Workday; cached jobs do not count
MAX_DETAIL_FETCH=300
WORKDAY_DETAIL_BUDGET=300
# Max listing pages walked per board (iCIMS, Taleo)
ICIMS_MAX_PAGES=40
TALEO_MAX_PAGES=40
CRAWLER_USER_AGENT=JobSearchBot/0.1 (+https://example.com/bot; contact@example.com)

POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch
POSTGRES_DB=jobsearch
# Used when running outside Docker (npm run dev:*). Compose overrides this to point at the db service.
DATABASE_URL=postgres://jobsearch:jobsearch@localhost:5432/jobsearch
REDIS_URL=redis://localhost:6379
CRAWLER_USER_AGENT=JobSearchBot/0.1 (+https://example.com/bot; contact@example.com)
WORKER_INTERVAL_MS=900000
MAX_FAILURES=12
# Worker scheduling: WORKER_INTERVAL_MS is the base crawl interval; quiet sources back off up to MAX_INTERVAL_HOURS
WORKER_CONCURRENCY=4
MAX_INTERVAL_HOURS=24
LEASE_MINUTES=30
WORKER_POLL_MS=5000
# Maintenance: close jobs from sources not crawled successfully for STALE_DAYS; delete jobs closed for RETENTION_DAYS
STALE_DAYS=7
RETENTION_DAYS=90
# Optional: enables the DB-backed API tests (they TRUNCATE jobs/sources). Must name a throwaway database containing "test"; never point at DATABASE_URL.
# TEST_DATABASE_URL=postgres://jobsearch:jobsearch@localhost:5432/jobsearch_test

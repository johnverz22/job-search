{
  "name": "job-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm ci --include=dev --prefix web && npm run build --prefix web && npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "discover": "tsx src/discover.ts",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "web:test": "npm test --prefix web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.0"
  }
}
